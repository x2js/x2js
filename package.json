{
    "name": "x2js",
    "version": "3.4.4",
    "description": "Transforms between XML string and JavaScript object trees.",
    "main": "x2js.js",
    "types": "x2js.d.ts",
    "files": [
        "CHANGELOG.md",
        "x2js.d.ts"
    ],
    "dependencies": {
        "@xmldom/xmldom": "^0.9.12"
    },
    "devDependencies": {
        "eslint": "^8.25.0",
        "eslint-config-axinom": "^1.0.3",
        "rimraf": "^2.6.3",
        "uglify-js": "^3.4.9",
        "vitest": "^3.0.0"
    },
    "scripts": {
        "test": "vitest run && npx eslint --env node --no-eslintrc --config ./node_modules/eslint-config-axinom/index.js *.js",
        "prepublish": "rimraf dist && mkdir dist && npx uglifyjs x2js.js -o dist/x2js.min.js -c -m --source-map \"includeSources='true',url='x2js.min.js.map'\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/x2js/x2js.git"
    },
    "keywords": [
        "xml",
        "convert",
        "transform",
        "mapping",
        "map"
    ],
    "author": "Axinom",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/x2js/x2js/issues"
    },
    "homepage": "https://github.com/x2js/x2js#readme",
    "eslintConfig": {
        "extends": "axinom",
        "env": {
            "node": true
        },
        "rules": {
            "indent": [
                2,
                "tab",
                {
                    "SwitchCase": 1
                }
            ]
        }
    },
    "publishConfig": {
        "access": "public"
    }
}